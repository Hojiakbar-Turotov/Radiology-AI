{
  "manifest_version": 3,
  "name": "RONS Navbat - Vrach Ish Stoli",
  "version": "1.0.0",
  "description": "Shifokor kompyuterida o'ziga tegishli bemorlar navbatini doimiy ko'rsatib turuvchi va 1 ta tugma bilan TV monitoriga chaqiruvchi kengaytma",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.firebaseio.com/*",
    "http://192.168.150.111:2025/*",
    "http://192.168.150.111/*",
    "http://213.230.91.59:2025/*",
    "http://213.230.91.59/*",
    "https://213.230.91.59:2025/*",
    "https://213.230.91.59/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Vrach Navbat Paneli"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://192.168.150.111:2025/*",
        "http://192.168.150.111/*",
        "http://213.230.91.59:2025/*",
        "http://213.230.91.59/*",
        "https://213.230.91.59:2025/*",
        "https://213.230.91.59/*",
        "http://*/*",
        "https://*/*"
      ],
      "all_frames": true,
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}

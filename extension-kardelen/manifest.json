{
  "manifest_version": 3,
  "name": "RONS Navbat Tizimi - Kardelen Integratsiyasi",
  "version": "1.0.0",
  "description": "Kardelen Radiologiya tizimidan bemorlarni 1 ta tugma bilan to'g'ridan-to'g'ri Firebase navbatiga yuborish kengaytmasi",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/logo-onko.png",
    "48": "icons/logo-onko.png",
    "128": "icons/logo-onko.png"
  },
  "host_permissions": [
    "http://192.168.150.111:2025/*",
    "http://192.168.150.111/*",
    "https://192.168.150.111:2025/*",
    "https://192.168.150.111/*",
    "http://213.230.91.59:2025/*",
    "http://213.230.91.59/*",
    "https://213.230.91.59:2025/*",
    "https://213.230.91.59/*",
    "*://*.karmed.uz/*",
    "*://*.karmed.com/*",
    "*://*.kardelen.uz/*",
    "*://*.kardelen.com/*",
    "https://*.firebaseio.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "RONS Navbat Sozlamalari",
    "default_icon": {
      "16": "icons/logo-onko.png",
      "48": "icons/logo-onko.png",
      "128": "icons/logo-onko.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://192.168.150.111:2025/*",
        "http://192.168.150.111/*",
        "https://192.168.150.111:2025/*",
        "https://192.168.150.111/*",
        "http://213.230.91.59:2025/*",
        "http://213.230.91.59/*",
        "https://213.230.91.59:2025/*",
        "https://213.230.91.59/*",
        "*://*.karmed.uz/*",
        "*://*.karmed.com/*",
        "*://*.kardelen.uz/*",
        "*://*.kardelen.com/*"
      ],
      "all_frames": false,
      "js": ["logos.js", "i18n.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches": [
        "http://192.168.150.111:2025/*",
        "http://192.168.150.111/*",
        "https://192.168.150.111:2025/*",
        "https://192.168.150.111/*",
        "http://213.230.91.59:2025/*",
        "http://213.230.91.59/*",
        "https://213.230.91.59:2025/*",
        "https://213.230.91.59/*",
        "*://*.karmed.uz/*",
        "*://*.karmed.com/*",
        "*://*.kardelen.uz/*",
        "*://*.kardelen.com/*"
      ]
    }
  ]
}

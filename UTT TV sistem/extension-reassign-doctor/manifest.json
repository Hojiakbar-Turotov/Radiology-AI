{
  "manifest_version": 3,
  "name": "UTT Bemor Vrachini O'zgartirish va Yo'naltirish",
  "version": "1.0.0",
  "description": "Karmed orqali vrachga yozilgan bemorlarni aniqlash va ularni boshqa vrach qabuli navbatiga yo'naltirish kengaytmasi",
  "icons": {
    "16": "icons/logo-onko.png",
    "48": "icons/logo-onko.png",
    "128": "icons/logo-onko.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bemor Vrachini O'zgartirish",
    "default_icon": {
      "16": "icons/logo-onko.png",
      "48": "icons/logo-onko.png",
      "128": "icons/logo-onko.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>",
        "http://*/*",
        "https://*/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}

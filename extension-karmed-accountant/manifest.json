{
  "manifest_version": 3,
  "name": "Karmed Xizmat Narxlari & Preyskurant",
  "version": "2.1.0",
  "description": "Karmed tizimi uchun 168 ta rasmiy xizmat narxlari (Google Sheets asosida 3 ta tarif: Rezident, No Rezident, Sug'urta/Order), tezkor qidiruv va kalkulyator.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "icons": {
    "16": "icons/logo-onko.png",
    "48": "icons/logo-onko.png",
    "128": "icons/logo-onko.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Karmed Xizmat Narxlari",
    "default_icon": {
      "16": "icons/logo-onko.png",
      "48": "icons/logo-onko.png",
      "128": "icons/logo-onko.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://192.168.150.111:2025/*",
        "http://192.168.150.111/*",
        "https://192.168.150.111:2025/*",
        "https://192.168.150.111/*",
        "http://213.230.91.59:2025/*",
        "http://213.230.91.59/*",
        "https://213.230.91.59:2025/*",
        "https://213.230.91.59/*",
        "*://*.karmed.uz/*",
        "*://*.karmed.com/*",
        "*://*.kardelen.uz/*",
        "*://*.kardelen.com/*"
      ],
      "all_frames": false,
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "price_catalog.json",
        "icons/logo-onko.png",
        "icons/logo-ssv.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}